# Production server config (HostiQ / LiteSpeed). GitHub Pages ignores this file.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On

# Force HTTPS and the www host
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.content-chameleon.com%{REQUEST_URI} [L,R=301]

# Old WordPress URLs -> new pages
RewriteRule ^(ua|en)/?$ / [L,R=301]
RewriteRule ^(vacancii-ua|vacancii-en|copywriter-ua|lead-generation-specialist-ua|social-media-butterfly-ua)/?$ /vacancies.html [L,R=301]
RewriteRule ^(wp-admin|wp-login\.php|wp-content|wp-includes|xmlrpc\.php|feed)(/.*)?$ / [L,R=301]

# Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Browsers remember to use HTTPS only (1 year). Subdomains are not included on purpose.
  Header always set Strict-Transport-Security "max-age=31536000"
  # No other site may show these pages in a frame (clickjacking)
  Header always set X-Frame-Options "SAMEORIGIN"
  # Kept minimal so it cannot break inline scripts, GA4, Calendly or the SendPulse form
  Header always set Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'; upgrade-insecure-requests"
  # Pages never ask for the camera, microphone, location or payments
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
</IfModule>

# Link-only lead magnets: never index the PDFs (an HTML meta tag cannot cover a PDF)
<IfModule mod_headers.c>
  <FilesMatch "\.pdf$">
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>
